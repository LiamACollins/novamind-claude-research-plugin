{
  "name": "@novamind/claude-research",
  "version": "0.1.0",
  "description": "Drop-in Claude Agent SDK research provider. Runs beside an existing OpenAI Agents SDK research agent, over the RAG you already have.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx examples/run-demo.ts",
    "serve": "tsx examples/serve.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@anthropic-ai/sdk": "^0.93.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
