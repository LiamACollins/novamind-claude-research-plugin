# Credentials. Separate from OPENAI_API_KEY by design.
ANTHROPIC_API_KEY=

# Rollout. Start at shadow: customers get the incumbent answer, Claude runs and is recorded.
CLAUDE_RESEARCH_MODE=off          # off | shadow | split | on
CLAUDE_RESEARCH_SPLIT_PERCENT=0

# Pipeline
CLAUDE_RESEARCH_RESEARCHERS=3
CLAUDE_RESEARCH_HYPOTHESES=true
CLAUDE_RESEARCH_MAX_FINDINGS=5
CLAUDE_RESEARCH_MAX_HYPOTHESES=3
CLAUDE_RESEARCH_MAX_TOP_K=20
CLAUDE_RESEARCH_MAX_BUDGET_USD=5

# Models
CLAUDE_RESEARCH_LEAD_MODEL=claude-sonnet-5
CLAUDE_RESEARCH_SEARCH_MODEL=claude-sonnet-5
CLAUDE_RESEARCH_HYPOTHESIS_MODEL=claude-opus-5
